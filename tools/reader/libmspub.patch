+// Publisher often stores only the middle stops of a gradient in the shade array; the two ends are the
+// shape's fill and back colours. Without them a gradient comes out as one flat colour.
+void GradientFill::ensureEnds(ColorReference startColor, double startOpacity, ColorReference endColor, double endOpacity)
+{
+  if (m_stops.empty())
+    return;
+  if (m_stops.front().m_offsetPercent > 0)
+    m_stops.insert(m_stops.begin(), StopInfo(startColor, 0, startOpacity));
+  if (m_stops.back().m_offsetPercent < 100)
+    m_stops.push_back(StopInfo(endColor, 100, endOpacity));
+}
