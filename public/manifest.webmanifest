{
 "name": "Pubwork",
 "short_name": "Pubwork",
 "description": "Open, edit, print and convert Publisher (.pub) files in your browser.",
 "start_url": "/",
 "display": "standalone",
 "background_color": "#fff8f3",
 "theme_color": "#bf4e19",
 "icons": [
  {
   "src": "/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "/favicon.svg",
   "sizes": "any",
   "type": "image/svg+xml"
  }
 ],
 "file_handlers": [
  {
   "action": "/",
   "accept": {
    "application/x-mspublisher": [
     ".pub"
    ]
   }
  }
 ]
}